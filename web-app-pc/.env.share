# 分享专用构建配置（npm run build -- --mode share）
#
# 和 .env.production 的区别只有一处：
#   VITE_APP_BASE_URL 留空 —— axios 走「同源相对路径」/app/xxx
#   .env.production 写死了 http://localhost:8081，只有本机浏览器能访问，
#   别人通过隧道打开你的站点时 localhost 指的是他自己的电脑，必然请求失败。
#
# 相对路径由 tools/share-pc.mjs 那个静态服务器负责转发到真实后端。
VITE_APP_TITLE='归心寓'
VITE_APP_BASE_PATH='/'
VITE_APP_BASE_API='/app'
VITE_APP_BASE_URL=
