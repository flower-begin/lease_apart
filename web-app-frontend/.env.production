# 变量必须以 VITE_ 为前缀才能暴露给外部读取
VITE_APP_NODE_ENV='production'
# 项目名称
VITE_API_TITLE='归心寓'

# =============================================================================
# 后端接口地址
#   生产构建时 axios 的 baseURL 就是这个绝对地址（不走 vite 代理），
#   所以必须是"浏览器能直接访问到"的地址。
#
#   本地打包预览   -> http://localhost:8081
#   部署到 Pages   -> 必须换成公网可访问的后端地址
#   （CI 会用仓库变量 VITE_APP_BASE_URL 覆盖成本文件同级的 .env.production.local）
# =============================================================================
VITE_APP_BASE_URL='http://localhost:8081'

# =============================================================================
# 静态资源基础路径
#   部署在 https://<user>.github.io/<仓库名>/ 时必须改成 '/<仓库名>/'
#   部署在域名根路径（或本地预览）时保持 '/'
# =============================================================================
VITE_APP_BASE_PATH='/'
